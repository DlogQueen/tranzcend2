# Copy to .env and fill in real values. Never commit .env.
# In production these are set in the Vercel project's Environment Variables.

# Supabase — the anon key is safe to expose publicly ONLY if
# Row Level Security is enabled and correct on every table.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# DeepAR — treat as a secret. Restrict to your domains in the DeepAR dashboard.
VITE_DEEPAR_API_KEY=your-deepar-key
